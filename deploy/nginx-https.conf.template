# Render with envsubst '${API_DOMAIN}' ONLY; preserve nginx $variables.
limit_req_zone $binary_remote_addr zone=gibdd_api:10m rate=20r/s;
map $http_upgrade $gibdd_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 80;
    server_name ${API_DOMAIN};
    access_log off;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name ${API_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/gibdd-error.log warn;
    add_header Strict-Transport-Security "max-age=15552000" always;
    client_max_body_size 101m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $gibdd_connection_upgrade;
    proxy_read_timeout 75s;
    limit_req zone=gibdd_api burst=60 nodelay;
    limit_req_status 429;
    location = /api/v1/devices/register {
        # Initially allow only the operator's IP for the first CHIEF.
        include /etc/nginx/snippets/gibdd-bootstrap.conf;
        proxy_pass http://127.0.0.1:8001;
    }
    location / {
        proxy_pass http://127.0.0.1:8001;
    }
}
