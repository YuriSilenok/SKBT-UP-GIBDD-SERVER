DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
MEDIA_STORAGE_DIR=storage/media
# Must match consentVersion in the EYEWITNESS build configuration.
CONSENT_VERSION=2026-11-17-v1
